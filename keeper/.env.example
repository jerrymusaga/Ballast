# Which ledger, and how to authenticate to it.
# Copy to .env and fill in. .env is gitignored and must never be committed.

LEDGER_API_URL=http://localhost:7575

# ── Local sandbox ──────────────────────────────────────────────────────────
# Leave every credential below unset. The client runs unauthenticated, which is
# how a sandbox expects to be talked to, and the whole deploy path works.

# ── A shared node handed out to many participants ──────────────────────────
# There is no per-app secret to issue, because each person already has an
# account: you authenticate as YOURSELF and the ledger acts on your behalf.
# Endpoint values come from whoever operates the node.
#
#   OIDC_TOKEN_URL=
#   OIDC_CLIENT_ID=
#   OIDC_SCOPE=openid daml_ledger_api offline_access
#   OIDC_USERNAME=you@example.com
#   OIDC_PASSWORD=
#
# Run `npm run login` once. It exchanges the password for a refresh token and
# prints it. Put THAT in .env as OIDC_REFRESH_TOKEN, delete the password, and
# every later run authenticates without it.
#
#   OIDC_REFRESH_TOKEN=

# ── A validator with its own machine identity ──────────────────────────────
#   OIDC_CLIENT_SECRET=
#   OIDC_AUDIENCE=

# The ledger user commands are submitted as. On a shared node this is the
# authenticated subject and is read from the token, so leave it unset.
# LEDGER_USER_ID=
