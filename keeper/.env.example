# Seaport / FiveNorth hosted Canton validator (DevNet sandbox).
# Copy to .env and fill in. .env is gitignored and must never be committed.

LEDGER_API_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io
OIDC_TOKEN_URL=https://auth.sandbox.fivenorth.io/application/o/token/
OIDC_CLIENT_ID=validator-devnet-m2m
OIDC_CLIENT_SECRET=
OIDC_SCOPE=daml_ledger_api
OIDC_AUDIENCE=validator-devnet-m2m

# The ledger user the token authenticates as. Commands must be submitted as this user,
# and it must hold rights for every party they act on behalf of.
LEDGER_USER_ID=6
