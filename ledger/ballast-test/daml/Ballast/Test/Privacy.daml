-- Ballast — the privacy proof.
--
-- The product claims investors can trust a fund they cannot see into. That only works if a
-- value computed FROM private holdings can be disclosed to a party who cannot see those
-- holdings. Canton's sub-transaction privacy is what makes that possible: a party is shown
-- only the nodes of a transaction it is a stakeholder in, so the investor witnesses the NAV
-- being created without witnessing the holdings it was computed from.
--
-- These scripts prove that on real CIP-56 `Holding` contracts, and state honestly what they
-- do NOT prove.
module Ballast.Test.Privacy where

import Daml.Script
import DA.Assert ((===))
import Splice.Api.Token.HoldingV1

import Ballast.Fund
import Ballast.Testing.Registry (TestHolding(..))

-- ─────────────────────────────────────────────────────────────────────────────
-- Proof: one fund, real CIP-56 assets, four different realities.
-- ─────────────────────────────────────────────────────────────────────────────
spikeFourLenses : Script ()
spikeFourLenses = script do
  manager     <- allocateParty "Manager"
  vault       <- allocateParty "BallastVault"
  alice       <- allocateParty "Alice"
  bob         <- allocateParty "Bob"
  market      <- allocateParty "Market"
  -- Two SEPARATE instrument registries — as on DevNet, where cBTC and cETH are administered
  -- by different parties. This is what makes the registry leak survivable.
  btcRegistry <- allocateParty "cBTC-Registry"
  ethRegistry <- allocateParty "cETH-Registry"

  let fundId    = "BALLAST-01"
      investors = [alice, bob]
      cBTC      = InstrumentId with admin = btcRegistry, id = "cBTC"
      cETH      = InstrumentId with admin = ethRegistry, id = "cETH"

  fund <- submit (actAs [manager, vault]) do createCmd Fund with manager, vault, fundId, investors

  -- The portfolio: 12 cBTC + 300 cETH, issued by their registries to the fund's vault.
  -- These are real `Holding` interface contracts.
  hBtcT <- submit (actAs [btcRegistry, vault]) do createCmd TestHolding with admin = btcRegistry, owner = vault, instrumentId = cBTC, amount = 12.0
  hEthT <- submit (actAs [ethRegistry, vault]) do createCmd TestHolding with admin = ethRegistry, owner = vault, instrumentId = cETH, amount = 300.0

  let hBtc = toInterfaceContractId @Holding hBtcT
      hEth = toInterfaceContractId @Holding hEthT
      prices = [(cBTC, 64000.0), (cETH, 1850.0)]

  -- Each investor's stake, visible only to them.
  _ <- submit manager do createCmd Position with manager, investor = alice, fundId, units = 700.0
  _ <- submit manager do createCmd Position with manager, investor = bob, fundId, units = 300.0

  -- actAs manager, readAs vault — see the note on PublishNav.
  _ <- submit (actAs manager <> readAs vault) do exerciseCmd fund PublishNav with holdingCids = [hBtc, hEth], prices

  -- ── LENS 1 · Manager acting as the vault: sees the whole portfolio ──
  -- Note it is the VAULT that is the stakeholder on the assets. The manager party is not; it
  -- reads them as the vault, which is exactly the right the fund operator holds in production.
  vHoldings <- queryInterface @Holding vault
  length vHoldings === 2
  mPos <- query @Position manager
  length mPos === 2

  -- ── LENS 2 · Investor: own stake + NAV, but NOT the portfolio ──
  aHoldings <- queryInterface @Holding alice
  aPos      <- query @Position alice
  aNav      <- query @NavRecord alice
  length aHoldings === 0      -- THE CLAIM: the portfolio is invisible to investors
  length aPos === 1           -- ...but Alice sees her own stake
  length aNav === 1           -- ...and the NAV computed from what she cannot see

  let [(_, alicePos)] = aPos
  alicePos.investor === alice
  alicePos.units === 700.0

  bPos <- query @Position bob
  length bPos === 1
  let [(_, bobPos)] = bPos
  bobPos.investor === bob     -- investors are invisible to each other

  -- The NAV is real: 12 * 64,000 + 300 * 1,850 = 1,323,000
  let [(_, nav)] = aNav
  nav.nav === 1323000.0

  -- ── LENS 3 · Market: nothing at all ──
  xHoldings <- queryInterface @Holding market
  xPos      <- query @Position market
  xNav      <- query @NavRecord market
  xFund     <- query @Fund market
  length xHoldings === 0
  length xPos === 0
  length xNav === 0
  length xFund === 0

  -- ── LENS 4 · The registries: each sees ITS OWN instrument, and nothing else ──
  -- This is the honest limit from the README, made explicit rather than hidden. A CIP-56
  -- registry co-signs the holdings it issues, so it necessarily sees them. What it does not
  -- see is the rest of the basket, the fund, the investors, or the NAV — so no single
  -- registry can reconstruct the portfolio, and none of them is the front-runner anyway.
  btcView <- queryInterface @Holding btcRegistry
  ethView <- queryInterface @Holding ethRegistry
  length btcView === 1        -- the cBTC registry sees the cBTC leg...
  length ethView === 1        -- ...and the cETH registry sees the cETH leg...
  -- ...and neither sees the whole portfolio, the fund, or the NAV.
  btcFund <- query @Fund btcRegistry
  btcNav  <- query @NavRecord btcRegistry
  btcPos  <- query @Position btcRegistry
  length btcFund === 0
  length btcNav === 0
  length btcPos === 0

  pure ()

-- ─────────────────────────────────────────────────────────────────────────────
-- The guards actually bite. Each of these was a real hole in the first draft.
-- ─────────────────────────────────────────────────────────────────────────────
spikeNavGuards : Script ()
spikeNavGuards = script do
  manager     <- allocateParty "Manager"
  vault       <- allocateParty "BallastVault"
  outsider    <- allocateParty "OtherFundVault"
  alice       <- allocateParty "Alice"
  btcRegistry <- allocateParty "cBTC-Registry"

  let fundId = "BALLAST-01"
      cBTC   = InstrumentId with admin = btcRegistry, id = "cBTC"

  fund  <- submit (actAs [manager, vault]) do createCmd Fund with manager, vault, fundId, investors = [alice]
  hBtcT <- submit (actAs [btcRegistry, vault]) do createCmd TestHolding with admin = btcRegistry, owner = vault, instrumentId = cBTC, amount = 12.0
  let hBtc = toInterfaceContractId @Holding hBtcT

  -- 1. A missing price must fail, not silently value the leg at zero.
  submitMustFail (actAs manager <> readAs vault) do exerciseCmd fund PublishNav with holdingCids = [hBtc], prices = []

  -- 2. A non-positive price must fail.
  submitMustFail (actAs manager <> readAs vault) do exerciseCmd fund PublishNav with holdingCids = [hBtc], prices = [(cBTC, 0.0)]

  -- 3. The same holding presented twice must not be counted twice.
  submitMustFail (actAs manager <> readAs vault) do exerciseCmd fund PublishNav with holdingCids = [hBtc, hBtc], prices = [(cBTC, 64000.0)]

  -- 4. Another vault's holding must not be counted as this fund's.
  --    Note honestly: here Canton's own authorization also blocks it, because this fund's
  --    vault is not a stakeholder on the outsider's holding. The `hv.owner == vault` check is
  --    the second line of defence — it is what holds if the contract were ever explicitly
  --    disclosed to this participant.
  hOtherT <- submit (actAs [btcRegistry, outsider]) do createCmd TestHolding with admin = btcRegistry, owner = outsider, instrumentId = cBTC, amount = 999.0
  let hOther = toInterfaceContractId @Holding hOtherT
  submitMustFail (actAs manager <> readAs vault) do exerciseCmd fund PublishNav with holdingCids = [hOther], prices = [(cBTC, 64000.0)]

  -- The happy path still works.
  _ <- submit (actAs manager <> readAs vault) do exerciseCmd fund PublishNav with holdingCids = [hBtc], prices = [(cBTC, 64000.0)]
  navs <- query @NavRecord alice
  length navs === 1
  let [(_, nav)] = navs
  nav.nav === 768000.0

  pure ()
