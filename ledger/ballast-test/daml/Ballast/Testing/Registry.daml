-- TEST SCAFFOLDING ONLY — not part of the Ballast product.
--
-- Ballast never defines its own notion of an asset. The vault is written against the real
-- Canton Token Standard interfaces, so on DevNet it holds whatever a real registry issued —
-- real cBTC, cETH, USDCx.
--
-- But a Daml Script test cannot reach DevNet's registries, so something local has to issue
-- holdings and back allocations. That is all this module is: a minimal issuer implementing
-- the same interfaces. The INTERFACES are real; only the issuer is local. Nothing in the
-- `ballast` package refers to this module — it sees only `ContractId Holding` and
-- `ContractId Allocation`, exactly what it will see against a real registry.
module Ballast.Testing.Registry where

import DA.Foldable (forA_)
import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1

-- Note the signatories: `admin, owner`. The instrument admin co-signs every holding it
-- issues, because it must be able to authorise transfers of it. That is not a quirk of this
-- test registry — it is inherent to how a registry administers an instrument, and it is why
-- the README's threat model says the registry sees the fund's holdings of its own instrument.
template TestHolding
  with
    admin        : Party
    owner        : Party
    instrumentId : InstrumentId
    amount       : Decimal
  where
    signatory admin, owner
    ensure amount > 0.0

    interface instance Holding for TestHolding where
      view = HoldingView with
        owner
        instrumentId
        amount
        lock = None
        meta = emptyMetadata

-- | Mint a holding, or nothing at all if there is nothing to mint.
mintFor : Party -> Party -> InstrumentId -> Decimal -> Update [ContractId Holding]
mintFor admin owner instrumentId amount =
  if amount <= 0.0
    then pure []
    else do
      c <- create TestHolding with admin, owner, instrumentId, amount
      pure [toInterfaceContractId c]

-- | Hand the reserved amount back to the sender.
releaseToSender : Party -> AllocationSpecification -> Update [ContractId Holding]
releaseToSender admin spec =
  mintFor admin spec.transferLeg.sender spec.transferLeg.instrumentId spec.transferLeg.amount

-- | A CIP-56 `Allocation` that LOCKS, the way a production registry does.
--
-- The funding holdings are archived when the allocation is created, not when it settles —
-- the standard requires exactly that ("the successful allocation MUST archive all of these
-- holdings"), so that a second allocation cannot spend the same assets. The reserved amount
-- lives in the allocation itself until it settles or is released.
--
-- `holdingCids` is left empty in the view, which the standard explicitly permits for
-- registries that do not represent reserved holdings as separate on-ledger contracts.
template TestAllocation
  with
    admin : Party
    spec  : AllocationSpecification
  where
    signatory admin, spec.transferLeg.sender
    observer spec.transferLeg.receiver, spec.settlement.executor

    ensure spec.transferLeg.amount > 0.0

    interface instance Allocation for TestAllocation where
      view = AllocationView with
        allocation = spec
        holdingCids = []
        meta = emptyMetadata

      allocation_executeTransferImpl _self _arg = do
        -- The receiver's authority arrives via the choice controllers, which is what lets a
        -- holding be minted for them here.
        recv <- mintFor admin spec.transferLeg.receiver spec.transferLeg.instrumentId spec.transferLeg.amount
        pure Allocation_ExecuteTransferResult with
          senderHoldingCids = []
          receiverHoldingCids = recv
          meta = emptyMetadata

      allocation_cancelImpl _self _arg = do
        released <- releaseToSender admin spec
        pure Allocation_CancelResult with senderHoldingCids = released, meta = emptyMetadata

      allocation_withdrawImpl _self _arg = do
        released <- releaseToSender admin spec
        pure Allocation_WithdrawResult with senderHoldingCids = released, meta = emptyMetadata

-- | The factory a sender's wallet exercises to reserve assets. One-step: it returns a
-- completed allocation rather than a pending instruction.
template TestAllocationFactory
  with
    admin : Party
    users : [Party]   -- senders must see the factory to exercise it
  where
    signatory admin
    observer users

    interface instance AllocationFactory for TestAllocationFactory where
      view = AllocationFactoryView with admin, meta = emptyMetadata

      allocationFactory_publicFetchImpl _self arg = do
        assertMsg "factory admin mismatch" (arg.expectedAdmin == admin)
        pure AllocationFactoryView with admin, meta = emptyMetadata

      allocationFactory_allocateImpl _self arg = do
        assertMsg "factory admin mismatch" (arg.expectedAdmin == admin)
        let spec = arg.allocation
            leg  = spec.transferLeg
        assertMsg "this registry does not administer that instrument"
          (leg.instrumentId.admin == admin)

        hvs <- forA arg.inputHoldingCids (fmap view . fetch)
        forA_ hvs \hv -> do
          assertMsg "input holding is not the sender's" (hv.owner == leg.sender)
          assertMsg "input holding is the wrong instrument" (hv.instrumentId == leg.instrumentId)

        let total = sum (map (\hv -> hv.amount) hvs)
        assertMsg "input holdings do not cover the allocation" (total >= leg.amount)

        -- Archive the funding holdings. This is the step that makes a pre-allocation index
        -- stale, and the reason Ballast mediates allocation through VaultIndex.
        forA_ arg.inputHoldingCids archive

        allocCid <- create TestAllocation with admin, spec
        change <- mintFor admin leg.sender leg.instrumentId (total - leg.amount)
        pure AllocationInstructionResult with
          output = AllocationInstructionResult_Completed with allocationCid = toInterfaceContractId allocCid
          senderChangeCids = change
          meta = emptyMetadata
