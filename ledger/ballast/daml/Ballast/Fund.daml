-- Ballast — the fund itself.
--
-- This package contains NO asset template. The fund's holdings are real Canton Token Standard
-- assets: everything here sees them only as `Splice.Api.Token.HoldingV1.Holding`, the same
-- interface a DevNet cBTC holding implements. Ballast never defines, mirrors or mints an
-- instrument — it holds whatever a real registry issued.
--
-- (The test registry that issues holdings for the local test suite lives in the separate
-- `ballast-test` package, so it cannot end up in the DAR that gets deployed.)
module Ballast.Fund where

import DA.Time (RelTime)
import Splice.Api.Token.HoldingV1 (InstrumentId)

import Ballast.Oracle
import Ballast.Redemption
import Ballast.Subscription
import Ballast.Valuation
import Ballast.Vault

-- The published NAV. Computed on-ledger from holdings the investor cannot see.
--
-- Both of the caveats that used to sit here are now closed. The holdings come from the
-- VaultIndex rather than from whatever subset the manager felt like presenting, and the
-- prices come from a signed, freshness-checked PriceSet rather than from the manager's
-- keyboard. What is left is a number the manager can neither compute, cherry-pick nor mark.
template NavRecord
  with
    manager   : Party
    fundId    : Text
    nav       : Decimal
    asOf      : Time
    investors : [Party]
  where
    signatory manager
    observer investors

template Fund
  with
    manager     : Party
    vault       : Party   -- the party that OWNS the fund's CIP-56 holdings
    fundId      : Text
    oracle      : Party   -- the only pricing source this fund will accept
    maxPriceAge : RelTime -- how stale a price set may be before it is refused
    accepted    : [InstrumentId] -- what the fund takes as subscription
    payout      : InstrumentId   -- the single instrument it redeems in; see Ballast.Redemption
    investors   : [Party]
  where
    signatory manager, vault
    observer investors

    -- Reads the whole portfolio through the real CIP-56 interface, publishes only the total.
    --
    -- Two DIFFERENT mechanisms have to line up here, and it is worth being precise because
    -- conflating them is easy:
    --   * AUTHORITY to fetch — satisfied because `vault` is a signatory of Fund, so the vault's
    --     authority is present in this choice body.
    --   * VISIBILITY to read — NOT implied by the above. The submitting participant must also be
    --     able to read the contract, so the manager submits with `readAs vault`.
    -- Canton keeps these separate: holding the authority to use a contract is not the same as
    -- being able to see it.
    nonconsuming choice PublishNav : ContractId NavRecord
      with
        vaultIndexCid : ContractId VaultIndex
        priceSetCid   : ContractId PriceSet
      controller manager
      do
        -- Note what the manager no longer gets to supply: not the holdings, not the prices.
        prices <- freshPrices priceSetCid oracle maxPriceAge
        qs     <- portfolioOf vaultIndexCid vault fundId
        nav    <- navOf prices qs
        asOf   <- getTime
        create NavRecord with manager, fundId, nav, asOf, investors

    -- | Admit a new investor to the fund.
    --
    -- Without this the investor list is fixed at formation, which suits a fund with a known
    -- investor base and rules out anyone walking up and subscribing. Admission is the
    -- manager's commercial decision; the vault pre-authorised it by signing this contract.
    --
    -- NOTE THE HALF-ADMISSION HAZARD: the investor list exists on two contracts — this one and
    -- MandateBounds. Someone admitted to the Fund but not the bounds would hold units while
    -- being unable to see the rules they are entitled to hold the fund to, which is worse than
    -- not being admitted at all. Both choices must go in ONE submission; `Ballast.Test.Admit`
    -- proves the pair is atomic.
    choice AdmitInvestor : ContractId Fund
      with
        newInvestor : Party
      controller manager
      do
        assertMsg "already an investor in this fund" (newInvestor `notElem` investors)
        create this with investors = newInvestor :: investors

    -- | An investor registers a subscription.
    --
    -- This lives on Fund rather than standing alone because of who needs to sign. Taking
    -- delivery of the deposit later needs manager, vault AND investor authority in one
    -- transaction, and the manager must never be able to act as the vault. Exercising a
    -- choice on a contract the manager and vault have already signed is what supplies the
    -- other two signatures — the fund contract acts as the offering document, and subscribing
    -- under it is what they pre-authorised by creating it.
    --
    -- Note the consequence: an investor must already be an observer of the Fund to see it and
    -- exercise this. That suits a fund with a known investor base. An open-ended offering
    -- would need a separate, publicly visible contract to subscribe against.
    nonconsuming choice RequestSubscription : ContractId SubscriptionRequest
      with
        investor      : Party
        settlementRef : Text
      controller investor
      do
        assertMsg "not an investor in this fund" (investor `elem` investors)
        create SubscriptionRequest with
          manager, vault, investor, fundId, oracle, maxPriceAge
          accepted, settlementRef

    -- | An investor registers a redemption. Three signatures, for the same reason a
    -- subscription needs them: paying out of the vault needs the vault's authority, and the
    -- manager must never be able to supply it alone.
    nonconsuming choice RequestRedemption : ContractId RedemptionRequest
      with
        investor : Party
        units    : Decimal
      controller investor
      do
        assertMsg "not an investor in this fund" (investor `elem` investors)
        create RedemptionRequest with
          manager, vault, investor, fundId, oracle, maxPriceAge, payout, units
