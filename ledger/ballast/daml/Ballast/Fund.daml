-- Ballast — the fund itself.
--
-- This package contains NO asset template. The fund's holdings are real Canton Token Standard
-- assets: everything here sees them only as `Splice.Api.Token.HoldingV1.Holding`, the same
-- interface a DevNet cBTC holding implements. Ballast never defines, mirrors or mints an
-- instrument — it holds whatever a real registry issued.
--
-- (The test registry that issues holdings for the local test suite lives in the separate
-- `ballast-test` package, so it cannot end up in the DAR that gets deployed.)
module Ballast.Fund where

import DA.Time (RelTime)
import Splice.Api.Token.HoldingV1

import Ballast.Oracle
import Ballast.Valuation
import Ballast.Vault

-- An investor's stake. Observed by that investor ALONE, so investors are invisible
-- to each other.
template Position
  with
    manager  : Party
    investor : Party
    fundId   : Text
    units    : Decimal
  where
    signatory manager
    observer investor

-- The published NAV. Computed on-ledger from holdings the investor cannot see.
--
-- Both of the caveats that used to sit here are now closed. The holdings come from the
-- VaultIndex rather than from whatever subset the manager felt like presenting, and the
-- prices come from a signed, freshness-checked PriceSet rather than from the manager's
-- keyboard. What is left is a number the manager can neither compute, cherry-pick nor mark.
template NavRecord
  with
    manager   : Party
    fundId    : Text
    nav       : Decimal
    asOf      : Time
    investors : [Party]
  where
    signatory manager
    observer investors

template Fund
  with
    manager     : Party
    vault       : Party   -- the party that OWNS the fund's CIP-56 holdings
    fundId      : Text
    oracle      : Party   -- the only pricing source this fund will accept
    maxPriceAge : RelTime -- how stale a price set may be before it is refused
    investors   : [Party]
  where
    signatory manager, vault
    observer investors

    -- Reads the whole portfolio through the real CIP-56 interface, publishes only the total.
    --
    -- Two DIFFERENT mechanisms have to line up here, and it is worth being precise because
    -- conflating them is easy:
    --   * AUTHORITY to fetch — satisfied because `vault` is a signatory of Fund, so the vault's
    --     authority is present in this choice body.
    --   * VISIBILITY to read — NOT implied by the above. The submitting participant must also be
    --     able to read the contract, so the manager submits with `readAs vault`.
    -- Canton keeps these separate: holding the authority to use a contract is not the same as
    -- being able to see it.
    nonconsuming choice PublishNav : ContractId NavRecord
      with
        vaultIndexCid : ContractId VaultIndex
        priceSetCid   : ContractId PriceSet
      controller manager
      do
        -- Note what the manager no longer gets to supply: not the holdings, not the prices.
        prices <- freshPrices priceSetCid oracle maxPriceAge
        qs     <- portfolioOf vaultIndexCid vault fundId
        nav    <- navOf prices qs
        asOf   <- getTime
        create NavRecord with manager, fundId, nav, asOf, investors
